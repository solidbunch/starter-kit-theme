# Auto-detect text files, normalize to LF in the repo
* text=auto eol=lf

# Documents
*.md    text diff=markdown
*.txt   text

# Scripts
*.sh    text eol=lf
*.bash  text eol=lf

# Serialisation
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf

# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary

# Fonts
*.ttf    binary
*.otf    binary
*.eot    binary
*.woff   binary
*.woff2  binary

# Archives
*.zip  binary
*.gz   binary
*.tar  binary
*.7z   binary

# Lock files — hide from PR diffs / language stats
composer.lock      linguist-generated
package-lock.json  linguist-generated
mix-manifest.json  linguist-generated

# Git meta — never needed outside the repo
.gitattributes  export-ignore
.gitignore      export-ignore

# Dev-only directories/files specific to this repo
.github/            export-ignore
.claude/            export-ignore
tests/              export-ignore
phpunit.xml         export-ignore
phpcs.xml           export-ignore
.phpcs/             export-ignore
webfonts-loader/    export-ignore
.eslintrc.json      export-ignore
.stylelintrc.json   export-ignore
.babelrc            export-ignore
.editorconfig       export-ignore
