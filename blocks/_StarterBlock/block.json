{
  "apiVersion": 3,
  "name": "starter-kit/starter-block",
  "title": "Starter Block",
  "category": "starter-kit",
  "icon": "skb skb-starter",
  "description": "Boilerplate block — copy this folder, rename it, trim what you don't need. See blocks/CLAUDE.md for the full authoring guide, including the dynamic (PHP-rendered) variant.",
  "keywords": [
    "Starter",
    "Blank",
    "block"
  ],
  "textdomain": "",
  "styles": [],
  "supports": {
    "align": ["wide", "full"]
  },
  "example": {},
  "attributes": {
    "heading": {
      "type": "string",
      "source": "html",
      "selector": "h4.starter-block__heading"
    },
    "badgeLabel": {
      "type": "string",
      "source": "text",
      "selector": ".starter-block__badge"
    },
    "iconClass": {
      "type": "string",
      "source": "attribute",
      "selector": ".starter-block__icon",
      "attribute": "data-icon"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "variant": {
      "type": "string",
      "default": "value1"
    }
  }
}
